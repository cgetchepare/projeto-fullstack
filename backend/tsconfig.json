{
  "compilerOptions": {
    "target": "es2022",
    "module": "NodeNext", // Ou "CommonJS" dependendo da sua estrutura
    "outDir": "./dist",
    "rootDir": "./src",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true, // Essencial para importar o Express corretamente
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}